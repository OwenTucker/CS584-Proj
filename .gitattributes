# Normalise line endings; Unity writes LF on every platform.
* text=auto
*.cs text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.json text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.exr binary
*.fbx binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
